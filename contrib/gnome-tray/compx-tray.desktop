[Desktop Entry]
Type=Application
Name=CompX mouse tray
Comment=Battery, DPI and polling rate of the CompX / Ardor Gaming mouse
# `compx-tray` is enough: XDG autostart resolves Exec through PATH, and the
# script lands in ~/.local/bin, which the GNOME session already has.
Exec=compx-tray
Icon=input-mouse
Terminal=false
X-GNOME-Autostart-enabled=true
