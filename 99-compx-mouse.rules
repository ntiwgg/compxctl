# CompX / Ardor Gaming mice — USB vendor id 25a7.
#
# Two rules for two different jobs:
#
#  * hidraw — the vendor protocol itself (dpi, battery, status, probe, and the
#    EEPROM write behind `rate device --persist`). The config interface is a HID
#    interface that usbhid already owns, and hidraw is how user space reaches it
#    without detaching the kernel driver.
#  * usb_device — the port reset that follows `rate device --persist`
#    (USBDEVFS_RESET on /dev/bus/usb/BBB/DDD), so the receiver re-enumerates
#    instead of asking you to crawl under the desk. Without it the reset is
#    skipped with a warning and the command still does its job.
#
# TAG+="uaccess" grants access to the active logind session, so no group
# membership is required on a normal desktop. Without logind (SSH, old
# distros), run the device commands once with sudo instead — do not add
# GROUP="users": that group does not exist on Fedora or Arch and the rule would
# then silently grant nothing.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="25a7", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="25a7", TAG+="uaccess"
